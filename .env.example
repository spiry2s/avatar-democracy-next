# Copy this file to .env and fill in your key.
# Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides (defaults shown):
# AVATAR_MODEL=claude-opus-4-8       # cheaper: claude-sonnet-4-6; premium: claude-fable-5
# CHECKER_MODEL=claude-haiku-4-5     # independent cross-check model (capture defense)
# BILL_COOLING_OFF_SECONDS=604800       # 7 days; set 0 for instant demo
# DELEGATE_COOLING_OFF_SECONDS=604800   # 7 days; set 0 for instant demo
# POPULATION_SIZE=200
