# Copy this file to .env and fill in your key.
# Get one at https://console.anthropic.com
# Required for /api/analyze, Avatar votes, chamber axis-tagging, drift checks,
# and cross-bill conflict checks. The UI and the test suite run without it.
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides (defaults shown). See README.md for the full list.
# Provider ids select the vendor per role. Only "anthropic" is implemented.
# An OpenAI-compatible provider is the intended next addition; it is not wired up.
# Primary role: bill analysis, the operator Avatar vote, chamber axis tags.
# Checker role: vote cross-check, delegate drift, cross-bill conflict.
# CHECKER_PROVIDER falls back to LLM_PROVIDER when unset.
# Model ids are sent to whichever provider serves that role. The defaults are
# Anthropic model ids, so leaving these commented keeps today's models.
# LLM_PROVIDER=anthropic
# CHECKER_PROVIDER=anthropic
# AVATAR_MODEL=claude-sonnet-4-6
# CHECKER_MODEL=claude-haiku-4-5
# MULTI_MODEL_CHECK=1
# DELEGATE_DRIFT_CHECK=1
# CROSS_BILL_CONFLICT_CHECK=1
# POPULATION_SIZE=200
# BILL_COOLING_OFF_SECONDS=604800       # 7 days; set 0 for an instant demo
# EMERGENCY_COOLING_OFF_SECONDS=3600
# DELEGATE_COOLING_OFF_SECONDS=604800   # 7 days; set 0 for an instant demo
# ENDORSE_THRESHOLD_ORDINARY=25
# ENDORSE_THRESHOLD_MAJOR=250
# ENDORSE_THRESHOLD_CONSTITUTIONAL=2500
# EMERGENCY_THRESHOLD_MULTIPLIER=2
# ENDORSEMENT_REVOCATION_SECONDS=86400
# SECTION_PASSAGE_RATIO=0.5
# CHAMBER_VOTE_TAU=0.12
# HOST=127.0.0.1
# PORT=8000
