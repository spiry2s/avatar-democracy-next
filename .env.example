# Copy this file to .env and fill in your key.
# Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides (defaults shown):
# AVATAR_MODEL=claude-opus-5-5       # cheaper: claude-sonnet-5-5; most capable: claude-fable-5-1
# AVATAR_EFFORT=high                 # low | medium | high | xhigh | max
# CHECKER_MODEL=claude-haiku-5-5     # independent cross-check model (capture defense)
# AVATAR_ACCESS_TOKEN=               # require this token on every request (auto-generated for LAN binds)
# MAX_BILL_CHARS=1500000             # longer bills are cut, and the cut is shown to the citizen
# MAX_SOURCE_BYTES=26214400          # upload / URL-fetch size cap (25 MB)
# BILL_COOLING_OFF_SECONDS=604800       # 7 days; set 0 for instant demo
# DELEGATE_COOLING_OFF_SECONDS=604800   # 7 days; set 0 for instant demo
# POPULATION_SIZE=200
